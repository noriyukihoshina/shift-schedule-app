<style>
  table { border-collapse: collapse; }
  th, td { border: 0.5pt solid #cbd5e1; text-align: center; }
</style>
</head>
<body>
<table>
 <tr><th>No</th><th>氏名</th><th>1日</th></tr>
 <tr><td>1</td><td>佐藤 健一</td><td style=color:#DC2626; font-weight:bold;>休</td></tr>
</table>
</body>
